# AKTune: bounded interactive tuning; screen OFF restores captured values.
# Existing config files persist. Removed legacy keys are ignored.
daemon.interval_sec=8
daemon.debounce_ms=1200

# Top-app minimum on a 0..1024 scale (converted for cgroup v2).
# Existing higher vendor minima and all maximum clamps are preserved.
uclamp.top.min.interactive=128

# Only tune an already-active schedutil governor; microseconds, 500..1000000.
cpu.schedutil.on.little.up=6000
cpu.schedutil.on.little.down=20000
cpu.schedutil.on.big.up=3000
cpu.schedutil.on.big.down=18000
cpu.schedutil.on.prime.up=2000
cpu.schedutil.on.prime.down=15000

# Vendor-specific hooks: explicit opt-in; OFF restores captured values.
cpu.cpufreq_boost.enable=0
sched.boost.enable=0
touchboost.enable=0
touchboost.ms=150

# Optional GPU floor: supported frequencies only, 0..100% of hardware max.
# GPU governor and maximum frequency are never changed.
gpu.tuning.enable=0
gpu.min_freq_pct.on=0

# Optional read-ahead experiment, 0..512 KiB. Benchmark on your device.
# Vendor I/O scheduler, merging, queue depth and accounting are preserved.
io.read_ahead.enable=0
io.read_ahead_kb.on=128

# Legacy networking experiments remain opt-in.
net.tcp_low_latency.enable=0
net.tcp_timestamps.disable=0
